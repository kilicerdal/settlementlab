{
  "id": "C01",
  "title": "Reservation capacity and idempotent release",
  "target": "collateral",
  "steps": [
    {
      "action": "http",
      "method": "POST",
      "path": "/inventory",
      "data": {
        "asset": "ASSET-${run_id}",
        "quantity": 100
      },
      "status": 201,
      "assert": {
        "body.available": 100
      }
    },
    {
      "action": "http",
      "method": "POST",
      "path": "/reservations",
      "key": "${run_id}-reserve",
      "data": {
        "asset": "ASSET-${run_id}",
        "quantity": 10
      },
      "status": 201,
      "save": "reservation",
      "assert": {
        "body.status": "ACTIVE",
        "body.quantity": 10
      }
    },
    {
      "action": "http",
      "method": "POST",
      "path": "/reservations",
      "key": "${run_id}-oversubscribe",
      "data": {
        "asset": "ASSET-${run_id}",
        "quantity": 91
      },
      "status": 409,
      "assert": {
        "body.error": "Insufficient inventory"
      }
    },
    {
      "action": "http",
      "path": "/inventory/ASSET-${run_id}",
      "assert": {
        "body.available": 90
      }
    },
    {
      "action": "http",
      "method": "POST",
      "path": "/reservations/${reservation.id}/release",
      "data": {},
      "assert": {
        "body.status": "RELEASED"
      }
    },
    {
      "action": "http",
      "method": "POST",
      "path": "/reservations/${reservation.id}/release",
      "data": {},
      "assert": {
        "body.status": "RELEASED"
      }
    },
    {
      "action": "http",
      "path": "/inventory/ASSET-${run_id}",
      "assert": {
        "body.available": 100
      }
    }
  ]
}
